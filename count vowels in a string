class Solution {
    public int countVowels(String word) {
        int len = word.length() ; 
        int count = 0 ;
        word= word.toLowerCase();
        for(int i = 0 ; i < len ; i++){
            if(word.charAt(i) == 'a' || word.charAt(i) == 'e' || word.charAt(i) == 'o' || word.charAt(i) == 'i' ||  word.charAt(i) == 'u' ){
                count++;
            }
        }
        return count ;
        
    }
}
